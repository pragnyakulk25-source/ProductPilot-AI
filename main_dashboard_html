<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ProductPilot AI - Unified Lifecycle Workspace</title>
    <style>
        /* Modern Dark High-Fidelity Reset */
        body, html { 
            margin: 0; 
            padding: 0; 
            height: 100%; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif; 
            background: #0b0f19; 
            overflow: hidden; 
            color: #f8fafc;
        }
        
        /* Master Top Control Shell */
        .master-navbar { 
            display: flex; 
            background: #131926; 
            border-bottom: 2px solid #1e293b; 
            height: 60px;
            box-sizing: border-box;
            align-items: center;
            padding: 0 30px;
            justify-content: space-between;
        }

        .brand-section {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            background: linear-gradient(135deg, #38bdf8, #3b82f6);
            width: 12px;
            height: 24px;
            border-radius: 4px;
            transform: rotate(15deg);
        }

        .brand-title {
            font-weight: 700;
            font-size: 18px;
            letter-spacing: -0.5px;
            background: linear-gradient(to right, #f8fafc, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        /* Interactive Nav Controls */
        .tab-indicator { 
            background: #1e293b; 
            border: 1px solid #334155; 
            color: #38bdf8; 
            padding: 8px 20px; 
            font-size: 13px; 
            font-weight: 600;
            border-radius: 6px;
            letter-spacing: 0.3px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        
        /* Full Screen Workspace Matrix */
        .view-container { 
            width: 100%; 
            height: calc(100% - 60px); 
            border: none; 
            background: #0b0f19;
        }
        
        iframe { 
            width: 100%; 
            height: 100%; 
            border: none; 
            display: block; 
            background: transparent;
        }
    </style>
</head>
<body>

    <!-- 1. Master Control Top Bar -->
    <div class="master-navbar">
        <div class="brand-section">
            <div class="brand-logo"></div>
            <div class="brand-title">ProductPilot AI Framework</div>
        </div>
        <div class="tab-indicator">
            📋 Continuous Lifecycle Environment (Poorvi's Workspace)
        </div>
    </div>

    <!-- 2. Screen Viewport Matrix -->
    <div class="view-container">
        <!-- Renders Poorvi's application code template safely directly over your server environment -->
        <iframe id="lifecycle-viewport" src="templates/dashboard.html"></iframe>
    </div>

    <!-- 3. Localhost Bridge Controller Engine -->
    <script>
        console.log("ProductPilot AI Unified Node Orchestration Engine Active.");
        
        // This structural listener is ready to process any message events dispatched between components
        window.addEventListener('message', function(event) {
            console.log("Cross-Origin Signal Handshake Intercepted: ", event.data);
        });
    </script>
</body>
</html>